#!/bin/sh
# Pre-commit checks for this repository.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Checks, in order:
#   1. No email address in any file being committed. Addresses on the
#      documentation-reserved domains (example.com/.org/.net, *.example,
#      *.invalid, *.test) are allowed.
#   2. The identical copies of helptext.py stay identical.
#   3. Every skill folder under plugins/*/skills carries a LICENSE file
#      (that exact name, no extension) identical to the repository LICENSE.
#   4. Every staged .json file parses as JSON.
#   5. The two plugin manifests declare the same version.

set -u

fail=0

# --- 1. Email addresses -----------------------------------------------------
# Scan the full staged content of every added or modified file, not just the
# added lines, so an address can never ride along in an untouched line.
# Filenames are read line-wise (never word-split): a name with a space must
# not fall apart into fragments that `git show` silently fails on. The
# here-document keeps the loop in this shell so `fail=1` sticks.
files=$(git diff --cached --name-only --diff-filter=ACMR)
while IFS= read -r f; do
    [ -n "$f" ] || continue
    found=$(git show ":$f" 2>/dev/null \
        | LC_ALL=C grep -aoE '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
        | grep -viE '@(([A-Za-z0-9-]+\.)*example\.(com|org|net)|[A-Za-z0-9.-]+\.(example|invalid|test))$' \
        | sort -u)
    if [ -n "$found" ]; then
        echo "pre-commit: email address in $f:" >&2
        echo "$found" | sed 's/^/    /' >&2
        fail=1
    fi
done <<EOF
$files
EOF
if [ "$fail" -ne 0 ]; then
    echo "Remove the address, or use one on example.com." >&2
fi

# --- 2. helptext.py copies --------------------------------------------------
canon="plugins/xojo/skills/xojo/scripts/helptext.py"
copies="plugins/xojo/skills/xojo-lint/scripts/helptext.py
plugins/xojo/skills/xojo-ide/scripts/xojoctl/helptext.py"

canon_sha=$(git ls-files -s "$canon" | awk '{print $2}')
if [ -n "$canon_sha" ]; then
    for copy in $copies; do
        copy_sha=$(git ls-files -s "$copy" | awk '{print $2}')
        if [ -n "$copy_sha" ] && [ "$copy_sha" != "$canon_sha" ]; then
            echo "pre-commit: $copy differs from $canon" >&2
            echo "These are maintained as identical copies; apply the same edit to every copy." >&2
            fail=1
        fi
    done
fi

# --- 3. LICENSE copies ------------------------------------------------------
# Skill folders are found by glob, not listed, so a new skill is checked the
# moment it exists. Unlike the helptext check, a missing copy is an error: a
# skill copied out of the repository must carry its own license.
canon="LICENSE"
canon_sha=$(git ls-files -s "$canon" | awk '{print $2}')
if [ -n "$canon_sha" ]; then
    for dir in plugins/*/skills/*/; do
        [ -d "$dir" ] || continue
        copy="${dir}LICENSE"
        copy_sha=$(git ls-files -s "$copy" | awk '{print $2}')
        if [ -z "$copy_sha" ]; then
            echo "pre-commit: $copy is missing" >&2
            echo "Every skill carries a copy of the repository LICENSE: cp $canon $copy && git add $copy" >&2
            fail=1
        elif [ "$copy_sha" != "$canon_sha" ]; then
            echo "pre-commit: $copy differs from $canon" >&2
            echo "These are maintained as identical copies; apply the same edit to every copy." >&2
            fail=1
        fi
        if [ -n "$(git ls-files -s "${dir}LICENSE.txt")" ]; then
            echo "pre-commit: ${dir}LICENSE.txt: the license file is named LICENSE, with no extension" >&2
            fail=1
        fi
    done
fi

# --- 4. JSON validity -------------------------------------------------------
if command -v python3 >/dev/null 2>&1; then
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        case "$f" in
            *.json)
                if ! git show ":$f" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then
                    echo "pre-commit: $f is not valid JSON" >&2
                    fail=1
                fi
                ;;
        esac
    done <<EOF
$files
EOF
fi

# --- 5. Plugin manifest versions --------------------------------------------
claude_manifest="plugins/xojo/.claude-plugin/plugin.json"
codex_manifest="plugins/xojo/.codex-plugin/plugin.json"
if command -v python3 >/dev/null 2>&1 \
    && [ -n "$(git ls-files -s "$claude_manifest")" ] \
    && [ -n "$(git ls-files -s "$codex_manifest")" ]; then
    claude_version=$(git show ":$claude_manifest" 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null)
    codex_version=$(git show ":$codex_manifest" 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version", ""))' 2>/dev/null)
    # An empty version means the manifest failed to parse or has no
    # "version" key; two empties must not compare as a match.
    if [ -z "$claude_version" ] || [ -z "$codex_version" ]; then
        [ -n "$claude_version" ] || echo "pre-commit: could not read the version from staged $claude_manifest" >&2
        [ -n "$codex_version" ] || echo "pre-commit: could not read the version from staged $codex_manifest" >&2
        echo "Check that the manifest is valid JSON with a \"version\" key." >&2
        fail=1
    elif [ "$claude_version" != "$codex_version" ]; then
        echo "pre-commit: version in $codex_manifest ($codex_version) differs from $claude_manifest ($claude_version)" >&2
        echo "These are maintained as matching versions; apply the same bump to both manifests." >&2
        fail=1
    fi
fi

exit "$fail"
